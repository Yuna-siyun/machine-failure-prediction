   "source": [
    "# [Purpose]: Compare K values using 5-fold cross-validation on training data only.\n",
    "cv_rows = []\n",
    "for k in [3, 5, 7, 9]:\n",
    "    pipe = build_pipeline(\n",
    "        KNeighborsClassifier(n_neighbors=k, metric=\"minkowski\", leaf_size=20),\n",
    "        mode=\"paper\",\n",
    "    )\n",
    "    f1_scores = cross_val_score(pipe, X_train, y_train, cv=5, scoring=\"f1\")\n",
    "    acc_scores = cross_val_score(pipe, X_train, y_train, cv=5, scoring=\"accuracy\")\n",
    "    cv_rows.append({\n",
    "        \"K\": k,\n",
    "        \"mean_cv_f1\": f1_scores.mean(),\n",
    "        \"std_cv_f1\": f1_scores.std(),\n",
    "        \"mean_cv_accuracy\": acc_scores.mean(),\n",
    "    })\n",
    "\n",
    "knn_cv_results = pd.DataFrame(cv_rows).round(4)\n",
    "knn_cv_results"
   ]
  },
