    "\n",
    "print(\"X_train:\", X_train.shape, \" X_test:\", X_test.shape)\n",
    "print(\"Failures in train:\", y_train.sum(), \"/\", len(y_train))\n",
    "print(\"Failures in test :\", y_test.sum(), \"/\", len(y_test))\n",
    "X_train.head()"
   ]
