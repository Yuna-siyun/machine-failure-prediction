   "source": [
    "# [Purpose]: Fit the SVM model (RBF kernel) and predict labels for the test data.\n",
    "# In the paper, Table II labels the row "SVM - Linear Kernel" but specifies kernel='rbf'.\n",
    "# We follow the listed hyperparameters (rbf, gamma='scale').\n",
    "svm_model = build_pipeline(\n",
    "    SVC(kernel=\"rbf\", gamma=\"scale\"),\n",
    "    mode=\"paper\",\n",
    ")\n",
    "svm_model.fit(X_train, y_train)\n",
    "y_pred_svm = svm_model.predict(X_test)\n",
    "\n",
    "print(\"SVM trained (RBF kernel).\")\n",
    "print(\"Predicted failures in test:\", y_pred_svm.sum(), \"of\", len(y_pred_svm))"
   ]
  },
